{
	"name": "miyo-hakobi",
	"version": "0.2.1",
	"description": "Scheduled Vault Import / Export - Files Move. You don't have to. Local Filesystem <=> Vault - Import / Export — import voice memos / snippets / etc. into your inbox, export folders / tags / notes to external locations.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:vault": "DEPLOY_VAULT=1 node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:vault": "DEPLOY_VAULT=1 npm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:live": "vitest run --config vitest.live.config.ts",
		"lint": "eslint . && stylelint styles.css",
		"lint:css": "stylelint styles.css",
		"lint:fix": "eslint . --fix",
		"audit": "npm audit --audit-level=high --omit=dev"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.1",
		"@types/node": "^22.0.0",
		"esbuild": "0.25.5",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.2.5",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"jsdom": "^26.1.0",
		"semantic-release": "^25.0.9",
		"stylelint": "17.13.0",
		"stylelint-no-unsupported-browser-features": "8.1.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.59.0",
		"vitest": "^3.2.1"
	},
	"peerDependencies": {
		"obsidian": ">=1.6.6"
	},
	"browserslist": [
		"chrome 124"
	]
}
