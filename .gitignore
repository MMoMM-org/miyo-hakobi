# Test coverage
coverage/

# Sourcemaps
*.map

# Obsidian
data.json

# macOS
.DS_Store

# Workspace scratch / inter-project message channels — local-only, not committed
temp/
_inbox/
_outbox/
_archive/

# Live-test scratch — vault-backed E2E tests build tmp source/vault dirs here.
test/tmp/

# Runtime artefacts produced by the test vault during live manual testing —
# audit logs, per-device state, plugin config, and the generic /tmp/ export
# sink. These are session output, not source.
/tmp/
test/Hakobi/.obsidian/plugins/miyo-hakobi/audit/
test/Hakobi/.obsidian/plugins/miyo-hakobi/device.json
test/Hakobi/.obsidian/plugins/miyo-hakobi/data.json

# Inbox in the test vault is the destination of the Recorder import rule —
# anything that lands there is transient session data (voice memos, txt
# imports), not source. History was rewritten on 2026-05-03 to remove the
# previously-tracked files; the backup-pre-100inbox-rewrite tag holds them
# if needed.
test/Hakobi/100 Inbox/

# MCP config (may contain API keys)
.mcp.json

# Claude Code — ignore everything except the committed settings stub
.claude/*
!.claude/settings.json

# Docker-based dev environment (deployed by ~/Kouzou/scripts/) — anchored to repo root
/claude-docker/
/claude-docker-home/
/begin-code.sh
/generated-images/
